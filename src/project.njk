---
pagination:
  data: projects
  size: 1
  alias: p
permalink: "/{{ p.slug }}/index.html"
eleventyExcludeFromCollections: true
---
{#
  One page per project, at /rock-stage/ and so on, so a project can be sent to
  someone on its own.

  Deliberately a different reading of the same content rather than the same
  layout in a narrower frame: everything is stacked vertically and scrolled,
  because a link someone has been sent should show its whole hand at once. The
  home page keeps the horizontal carousel, where the point is to move through
  the work rather than to study one piece of it.

  It shares the stylesheet and adds project.css on top; nothing here re-declares
  a colour or a typeface.
#}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ p.title }} · {{ settings.site.title }}</title>

    <link
      rel="preload"
      as="image"
      type="image/avif"
      href="{{ p.hero.file | largest('avif') | abs }}"
      imagesrcset="{{ p.hero.file | srcset('avif') | abs }}"
      imagesizes="(min-width: 1200px) 50vw, 100vw"
      fetchpriority="high" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/fonts/Instrument.woff2"
      crossorigin />

    <link rel="stylesheet" href="/assets/css/styles.css?v=20260802ah" media="all" />
    <link rel="stylesheet" href="/assets/css/project.css?v=20260802ah" media="all" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png" />

    {#- The share card. The title carries the studio name as well as the
        project, because a link posted on its own has no other context, and the
        description is the project's own opening sentence rather than the site
        blurb, so nineteen links do not all preview identically.

        The image is the project's hero at its real dimensions, read from the
        file: a declared size that does not match the file makes every crawler
        that trusts it reserve the wrong shape. og:image must be absolute. #}
    {%- set desc = p.panels[0][0] | striptags %}
    {%- set shareDesc = desc | truncate(200) %}
    {%- set shareTitle = p.title + " · " + settings.site.title %}
    <meta name="description" content="{{ shareDesc }}" />
    <meta name="author" content="Rose Hallgren" />
    <link rel="canonical" href="https://rosehallgren.se/{{ p.slug }}/" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://rosehallgren.se/{{ p.slug }}/" />
    <meta property="og:site_name" content="{{ settings.site.title }}" />
    <meta property="og:title" content="{{ shareTitle }}" />
    <meta property="og:description" content="{{ shareDesc }}" />
    <meta property="og:image" content="https://rosehallgren.se{{ p.hero.file | largest('webp') | abs }}" />
    <meta property="og:image:width" content="{{ p.hero.file | intrinsicWidth }}" />
    <meta property="og:image:height" content="{{ p.hero.file | intrinsicHeight }}" />
    <meta property="og:image:alt" content="{{ p.hero.alt }}" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:locale:alternate" content="sv_SE" />
    {%- if p.year %}
    <meta property="article:published_time" content="{{ p.year | first4 }}-01-01" />
    {%- endif %}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ shareTitle }}" />
    <meta name="twitter:description" content="{{ shareDesc }}" />
    <meta name="twitter:image" content="https://rosehallgren.se{{ p.hero.file | largest('webp') | abs }}" />
    <meta name="twitter:image:alt" content="{{ p.hero.alt }}" />

    <meta name="theme-color" content="{{ p.color }}" />

    {#- CreativeWork, built from the project's own front matter, so it cannot
        drift the way a hand-written block would. #}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        "name": {{ p.title | dump | safe }},
        "url": "https://rosehallgren.se/{{ p.slug }}/",
        "description": {{ shareDesc | dump | safe }},
        "image": "https://rosehallgren.se{{ p.hero.file | largest('webp') | abs }}",
        {%- if p.year %}
        "dateCreated": {{ (p.year | first4) | dump | safe }},
        {%- endif %}
        {%- if p.location %}
        "locationCreated": { "@type": "Place", "name": {{ p.location | dump | safe }} },
        {%- endif %}
        "creator": {
          "@type": "Person",
          "name": "Rose Hallgren",
          "url": "https://rosehallgren.se/"
        }
      }
    </script>
  </head>
  <body class="project-page" style="--project-text-bg: {{ p.color }}">
    <main>
      <header class="project-page-header">
        <a class="project-page-mark" href="/" aria-label="Studio Rose Hallgren, all work">
          {% set markId = "logo-project" %}{% include "wordmark.njk" %}
        </a>
        {#- No year/location line: the copy underneath says where and when in a
            sentence, and the standalone metadata was repeating it. #}
        <h1{% if p.lang %} lang="{{ p.lang }}"{% endif %}>{{ p.title }}</h1>
      </header>

      <div class="project-page-body">
{%- for panel in p.panels %}
{%- for para in panel %}
        <p>{{ para | autolink | safe }}</p>
{%- endfor %}
{%- endfor %}
{%- for l in p.links %}
        <p>
          <a href="{{ l.url }}" target="_blank" rel="noopener noreferrer">{{ l.label }}</a>
        </p>
{%- endfor %}
{%- if p.credits | length %}
        <p class="credit">{% for c in p.credits %}<span class="credit-line">{{ c | autolink | safe }}</span>{% endfor %}</p>
{%- endif %}
{%- if p.press | length %}
        <p class="press">Press: {% for x in p.press %}<a href="{{ x.url }}" target="_blank" rel="noopener noreferrer">{{ x.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
{%- endif %}
      </div>

      <div class="project-page-media">
{%- for m in p.media %}
{%- if m.video %}
        <div class="project-page-video">
          <iframe
            src="https://www.youtube-nocookie.com/embed/{{ m.video }}"
            title="{{ m.title }}"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            sandbox="allow-scripts allow-same-origin allow-presentation allow-popups allow-popups-to-escape-sandbox"></iframe>
        </div>
{%- else %}
        <figure>
          <picture>
            <source
              type="image/avif"
              srcset="{{ m.file | srcset('avif') | abs }}"
              sizes="(min-width: 1200px) 50vw, 100vw" />
            <img
              src="{{ m.file | largest('webp') | abs }}"
              srcset="{{ m.file | srcset('webp') | abs }}"
              sizes="(min-width: 1200px) 50vw, 100vw"
              alt="{{ m.alt }}"
              width="{{ m.file | intrinsicWidth }}"
              height="{{ m.file | intrinsicHeight }}"
              decoding="async"
              loading="{{ "eager" if loop.first else "lazy" }}" />
          </picture>
          {#- Cmd+P. Chrome re-embeds WebP into a PDF almost uncompressed, so the
              deck carries a JPEG per picture and so does this page. display:none
              on screen means it has no layout box and never loads until the
              print stylesheet applies. #}
          <img
            class="print-only"
            src="{{ m.file | printSrc | abs }}"
            alt=""
            aria-hidden="true"
            loading="lazy" />
        </figure>
{%- endif %}
{%- endfor %}
      </div>

      {#- The next project by position, wrapping round at the end, so a page
          someone landed on from a link leads somewhere rather than stopping. #}
      {%- set idx = projects.indexOf(p) %}
      {%- set next = projects[(idx + 1) % (projects | length)] %}
      <nav class="project-page-nav">
        {#- The arrow does the work the word "Next" was doing, and sits on the
            right where the eye already is at the end of a scroll. It is marked
            aria-hidden and the link keeps an accessible name, so a screen
            reader hears the project rather than a punctuation character. #}
        <a class="project-page-next" href="/{{ next.slug }}/" aria-label="Next project: {{ next.title }}">
          <span class="project-page-next-arrow" aria-hidden="true">&#8594;</span>
          <span{% if next.lang %} lang="{{ next.lang }}"{% endif %}>{{ next.title }}</span>
        </a>
      </nav>
    </main>
    {#- The footer takes this project's own colour, the way the home page footer
        takes the last project's, so the page has one ground from top to bottom
        rather than ending on white. #}
    {% set footerBg = p.color %}{% include "footer.njk" %}
  </body>
</html>
