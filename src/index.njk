---
permalink: index.html
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ settings.site.title }}</title>

    <!-- Preloads before the stylesheet, deliberately. The preload scanner reads
         the head in order, so with the stylesheet first the LCP image was not
         discovered until 461ms in: 18% of LCP spent on Load Delay alone. -->
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href="{{ projects[0].hero.file | largest('avif') }}"
      imagesrcset="{{ projects[0].hero.file | srcset('avif') }}"
      imagesizes="(min-width: 1600px) 50vw, 100vw"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="assets/fonts/Instrument.woff2"
      crossorigin
    />

    <link
      rel="stylesheet"
      href="assets/css/styles.css?v=20260802aj"
      media="all"
    />
    <link rel="icon" type="image/svg+xml" href="assets/favicon/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="assets/favicon/favicon-96x96.png" />
    <!-- PNG, not the generated WebP: cwebp dropped the alpha channel and
         flattened it to a blank black square, and iOS does not accept WebP
         for touch icons regardless. -->
    <link rel="apple-touch-icon" href="assets/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="assets/favicon/site.webmanifest" />

    {#- Everything below that a person would ever want to change comes from
        content/settings.json, so Rose can edit it in Pages CMS. What stays
        hardcoded is structural: the canonical URL, the locale, the robots
        directives and the geo tags. #}
    {%- set portrait = "/assets/images/projects/rose-hallgren-portrait.jpg" %}
    {%- set shareTitle = settings.site.social_title or settings.site.title %}
    {%- set shareImage = settings.site.social_image %}
    {%- set shareSize = shareImage | imageSize %}
    <meta name="description" content="{{ settings.site.description }}" />
    <meta name="author" content="Rose Hallgren" />
    <meta name="apple-mobile-web-app-title" content="{{ settings.site.title }}" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rosehallgren.se/" />
    <meta property="og:site_name" content="{{ settings.site.title }}" />
    <meta property="og:title" content="{{ shareTitle }}" />
    <meta property="og:description" content="{{ settings.site.description }}" />
    <meta property="og:image" content="https://rosehallgren.se{{ shareImage }}" />
    {#- Read from the file rather than asserted. These were declared 1200x630
        against an image that is actually 1500x998, so every crawler that
        trusted the declaration reserved the wrong shape. #}
    <meta property="og:image:width" content="{{ shareSize.width }}" />
    <meta property="og:image:height" content="{{ shareSize.height }}" />
    <meta property="og:image:alt" content="{{ settings.site.social_image_alt or settings.site.heading }}" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:locale:alternate" content="sv_SE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ shareTitle }}" />
    <meta name="twitter:description" content="{{ settings.site.description }}" />
    <meta name="twitter:image" content="https://rosehallgren.se{{ shareImage }}" />
    <meta name="twitter:image:alt" content="{{ settings.site.social_image_alt or settings.site.heading }}" />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href="https://rosehallgren.se/" />

    <meta name="geo.region" content="SE" />
    <meta name="geo.placename" content="Stockholm" />
    <meta name="geo.position" content="59.3293;18.0686" />

    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    {#- One Person, built from the same content as the page. The old markup also
        carried a CreativeWork listing four projects by name with hand-written
        descriptions; projects are reordered and renamed in the CMS and that
        list was not, so it was structured data slowly drifting away from the
        truth. sameAs is derived from the contact links. #}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Rose Hallgren",
        "jobTitle": "Multidisciplinary Architect and Designer",
        "description": {{ settings.site.description | dump | safe }},
        "url": "https://rosehallgren.se",
        "image": "https://rosehallgren.se{{ settings.site.social_image }}",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ (settings.site.studio_address | replace(", Stockholm", "")) | dump | safe }},
          "addressLocality": "Stockholm",
          "addressCountry": "SE"
        },
        "knowsAbout": [
          "Architecture",
          "Design",
          "Weaving",
          "Ceramics",
          "Spatial Design",
          "Craft Techniques"
        ],
        "sameAs": [
{%- for u in settings.sameAs %}
          {{ u | dump | safe }}{% if not loop.last %},{% endif %}
{%- endfor %}
        ]
      }
    </script>
  </head>
  <body>
    {#- The last project, whichever it is. This was hardcoded to #photography,
        which only worked while Photography held the highest position — a value
        Rose controls from the CMS. #}
    <a class="skip-link" href="#{{ (projects | last).slug }}"
      >Skip to the end of the work</a
    >
    <main>
      <section
        class="about-section"
        {%- if projects[0].color %} style="--intro-bg: {{ projects[0].color }}"{% endif %}>
                  {#- Rose and Sigge. First in the DOM and moved to the right with
              `order`, because in the deck it is a right float and a float only
              affects what follows it; as the last child it stacked under the
              copy and took the cover from 36 pages to 37. #}
          <figure class="about-portrait">
            <picture>
              <source
                type="image/avif"
                srcset="{{ portrait | srcset('avif') }}"
                sizes="var(--portrait-width)" />
              <img
                class="screen-only"
                src="{{ portrait | largest('webp') }}"
                srcset="{{ portrait | srcset('webp') }}"
                sizes="30vw"
                alt="Rose Hallgren outdoors at golden hour, eyes closed, with her dog Sigge against a cloudy sky"
                width="{{ portrait | intrinsicWidth }}"
                height="{{ portrait | intrinsicHeight }}"
                decoding="async"
                loading="lazy" />
            </picture>
            <img
              class="print-only"
              src="{{ portrait | printSrc }}"
              alt=""
              aria-hidden="true"
              loading="lazy" />
          </figure>
        <div class="about-content">
          <div class="about-text">
            <p>
              <a
                href="https://rosehallgren.se"
                aria-label="Studio Rose Hallgren, home"
              >
                <svg
                  id="logo-top"
                  aria-hidden="true"
                  focusable="false"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 512 372"
                  width="512"
                  height="372"
                >
