                  />
                  <path
                    d="M325.78,153.34c-35.56,26.43-36.78,77.15,14.85,83.18,14.66,1.71,37.71-.49,47.6-12.87,15.32-19.17-16.41-32.79-28.22-42.36-38.95-31.53-28.07-87.6,18.69-104.43,42.14-15.16,131.16-11.67,125.72,51.82-2.73,31.86-36.52,39.86-63.27,37.83v4.48c30.86,1.39,59.35,16.5,67.9,47.75,12.41,45.28-15.61,95.53-67.34,81.38-42.93-11.74-44.91-66.23-26.85-99.43l4.37,1.18c-.85,6.11,2.07,11.19,8.02,12.99,16.63,5.01,28.21-13.15,20.35-27.64-6.9-12.73-26.71-10.41-38.94-10.62v-6.16c12.78-.37,17.82-14.6,19.9-25.2,3.11-15.85,3.68-59.53-13.45-67.82-12.71-6.15-15.48,9.18-16,18.2-3.43,59.27,15.68,146.62-37.23,188.52-48.39,38.34-142.73,13.93-137.45-56.84,3.29-44.19,51.79-64.69,89.62-71.2l-.03-4.72-40.6.57c-7.13.92-14.27,1.83-21.12,4.08-4.66,1.53-8.9,3.94-13.33,5.99v-87.39h86.8v78.71l.02.02Z"
                  />
                  <path
                    d="M212.11,74.63v76.19l-84.86-.02c-18.1.65-44.75,7.22-49.82,27.47-8.56,34.24,39.54,47.3,48.73,10.66,2.06-8.21,1.19-16.47,1.48-24.85l.84-.84,4.68-.08c-.11,7.51.53,15.48,4.58,22.03,8.3,13.4,33.92,14.92,47.88,21.57,34.75,16.55,24.19,59.63,25.95,90.85-22.63-.96-50.73,4.29-69.45-11.48-23.14-19.5-17.37-57.29-10.64-83.19l-4.46.02c-6.87,36.73-24.68,96.04-69.72,99.16-42.13,2.91-62.56-33.03-56.13-71.28,7.45-44.38,51.26-71.35,93.04-77.13l.32-4.55c-26.79.95-56.16-4.18-80.08,10.64v-85.15h197.68-.02Z"
                  />
                  <path
                    d="M345.82.28c43.32-5.22,50.14,65.11.94,61.49-37.69-2.77-34.06-57.49-.94-61.49Z"
                  />
                  <path
                    d="M105.03,310.63c23.03-2.77,38.93,10.48,36.46,34.23-2.27,21.76-26.87,34.08-45.81,22.99-23.41-13.71-19.67-53.73,9.35-57.22h0Z"
                  />
                </svg>
              </a>
            </p>
{#- The page had no <h1> at all: it sat here, after the wordmark, and the
            migration replaced this whole block with the paragraph loop and dropped
            it. Restored, and driven by the "Heading" field, which until now wrote
            to nothing. #}
            <h1>{{ settings.site.heading }}</h1>
            {#- Already whole paragraphs: the CMS field is rich-text saving HTML,
                so it arrives with its own <p> tags. Splitting it again would
                nest them. #}
            {{ settings.site.intro | safe }}
          </div>
          <div class="about-contact">
            <p>
{%- for c in settings.contact %}{% if not c.footer_only %}
              <a href="{{ c.url }}"{% if c.url.startsWith("http") %} target="_blank" rel="noopener noreferrer"{% endif %}{% if c.label == "CV" %} aria-label="Download CV"{% endif %}>{{ c.label }}</a>
{%- endif %}{% endfor %}
            </p>
          </div>
        </div>
      </section>

{% include "projects.njk" %}
    </main>

{% set footerBg = (projects | last).color %}{% include "footer.njk" %}

    <script src="assets/js/main.js?v=20260802ag"></script>
  </body>
</html>
