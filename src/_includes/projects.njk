{#
  One project per markdown file in content/projects. Everything derivable is
  derived: the srcset ladders and intrinsic sizes come from the files on disk,
  and deck-tiles-N / deck-rows-M is the collage grid that wastes the fewest
  slots for this project's image count. Rose never sees any of it.

  Two shapes the old markup taught us and this has to keep:
    * a project can have more than one copy panel (a --- rule in the body);
    * a video can sit anywhere among the images, so `media` is one ordered
      list. Videos are hidden in print and never count toward the collage.
#}
{%- set SIZES = "(min-width: 1600px) 50vw, 100vw" %}
{%- macro imageSlide(img, extraClass, projectName, eager) %}
        <div{% if projectName %} data-project="{{ projectName }}"{% endif %} class="slide{% if extraClass %} {{ extraClass }}{% endif %}">
          <div class="image-slide" style="--bg-image: url({{ img.file | washSrc }})">
            <picture>
              <source
                type="image/avif"
                srcset="{{ img.file | srcset('avif') }}"
                sizes="{{ SIZES }}" />
              <img
                class="screen-only"
                src="{{ img.file | largest('webp') }}"
                srcset="{{ img.file | srcset('webp') }}"
                sizes="{{ SIZES }}"
                alt="{{ img.alt }}"
                width="{{ img.file | intrinsicWidth }}"
                height="{{ img.file | intrinsicHeight }}"
                decoding="async"
                {#- The first project's hero is the LCP image and is preloaded with
                    fetchpriority=high. Marking it lazy as well is the exact
                    anti-pattern Lighthouse flags, and would reintroduce the load
                    delay the preload exists to remove if the hero ever fell below
                    the fold. #}
                loading="{{ "eager" if eager else "lazy" }}" />
            </picture>
            <img
              class="print-only"
              src="{{ img.file | printSrc }}"
              alt=""
              aria-hidden="true"
              loading="lazy" />
          </div>
        </div>
{%- endmacro %}
{%- macro videoSlide(v) %}
        <div class="slide">
          <div class="video-slide">
            <iframe
              src="https://www.youtube-nocookie.com/embed/{{ v.video }}"
              title="{{ v.title }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              sandbox="allow-scripts allow-same-origin allow-presentation allow-popups allow-popups-to-escape-sandbox"></iframe>
          </div>
        </div>
{%- endmacro %}
{%- for p in projects %}
{#- Every other project opens on its copy instead of its photograph, so
    scrolling alternates between a picture and a coloured panel rather than
    hitting the same shape nineteen times.

    Marked as a class rather than reordered here, because it should only happen
    where two slides share the viewport — below that a slide fills the screen
    and leading with text just delays the work. The stylesheet does the swap
    with `order`, which only applies to a flex container, so the DOM order stays
    hero-first for print and for every narrower layout.

    The FIRST project is never marked: its hero is the LCP element the preload
    in the head points at. #}
{#- ...but never when the project has more than one copy panel, or the two
    would open back to back and you would scroll past two screens of text
    before reaching a photograph. Fluffy Encounters is the only one today. #}
{%- set copyFirst = ((loop.index % 2) == 0) and ((p.panels | length) == 1) %}
{#- Tiles per collage row, so a tile can say whether it ends one. See tileIndex
    in src/_data/projects.js for why this is not :nth-of-type. #}
{%- set tiles = p.supportCount | collageTiles %}
      <section
        class="project deck-tiles-{{ p.supportCount | collageTiles }} deck-rows-{{ p.supportCount | collageRows }}{% if copyFirst %} copy-first{% endif %}"
        id="{{ p.slug }}"
        {%- if p.color %} style="--project-text-bg: {{ p.color }}"{% endif %}
        {#- The surface the title and dots start on, so they are the right ink
            before main.js has run and for anyone it never runs for. A copy-first
            project opens on the dark panel, everything else on a veiled
            photograph, which the veil holds at paper. main.js overwrites both
            per slide from here on. #}
        data-title-on="{{ "panel" if copyFirst else "paper" }}"
        data-dots-on="{{ "panel" if copyFirst else "paper" }}"
        aria-labelledby="title-{{ p.slug }}">
        <h2 class="project-title" id="title-{{ p.slug }}"{% if p.lang %} lang="{{ p.lang }}"{% endif %}><a href="/{{ p.slug }}/">{{ p.title }}</a></h2>
{%- if p.year or p.location %}
        <p class="project-meta">{{ p.year }}{% if p.year and p.location %} · {% endif %}{{ p.location }}</p>
{%- endif %}
        <div class="project-carousel">
{%- if p.hero %}{{ imageSlide(p.hero, "deck-hero", "", loop.first) }}{% endif %}
{%- for panel in p.panels %}
        <div class="slide">
          <div class="slide-content">
{%- for para in panel %}
            <p>{{ para | autolink | safe }}</p>
{%- endfor %}
{%- if loop.last %}
{%- for l in p.links %}
            <p>
              <a href="{{ l.url }}" target="_blank" rel="noopener noreferrer">{{ l.label }}</a>
            </p>
{%- endfor %}
{%- if p.credits | length %}
            <p class="credit">{% for c in p.credits %}<span class="credit-line">{{ c | autolink | safe }}</span>{% endfor %}</p>
{%- endif %}
{%- if p.press | length %}
            <p class="press">Press: {% for x in p.press %}<a href="{{ x.url }}" target="_blank" rel="noopener noreferrer">{{ x.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
{%- endif %}
{%- endif %}
          </div>
        </div>
{%- endfor %}
{%- for m in p.rest %}
{%- if m.video %}{{ videoSlide(m) }}
{%- else %}
{{- imageSlide(m, ("deck-drawing " if m.drawing else "") + "deck-more" + (" deck-break" if m.leadsCollage else "") + (" deck-row-end" if (m.tileIndex % tiles) == 0 else ""), p.title if m.leadsCollage else "") }}
{%- endif %}
{%- endfor %}
        </div>
      </section>
{% endfor %}
